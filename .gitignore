# ============================================================================
# GenUI — Git 忽略规则
# 口径: 发布树只含 src/ 与 docs/(另含 README 与 LICENSE);
#       本地开发件(构建定义、依赖包、工具脚本、基准工程、早期设计图)不入库。
# ============================================================================

# ---- 构建输出(CMake / MSBuild 生成物, 任意层级) ----
out/
build/
CMakeCache.txt
CMakeFiles/
CMakeUserPresets.json
*.slnx
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.obj
*.pdb
*.ilk
*.exp
*.tlog
*.idb
*.exe
*.dll
*.lib
*.res

# ---- 依赖缓存(vcpkg / NuGet 还原产物) ----
vcpkg_installed/
nuget-packages/
packages/

# ---- 本地构建链(发布树不含构建定义与依赖) ----
CMakeLists.txt
vcpkg.json
NuGet.config
nuget/
tools/
bench/
cmake/
/GenUI.json

# ---- 早期设计资产(与当前界面不符, 不入库) ----
/editor.png
/eg.png
/UI 设计.pptx

# ---- 临时工作区 ----
_tmp/
temp/
drafts/

# ---- 手动备份(版本管理交由 Git, 不再落盘) ----
backup/
*.bak
*.bak-*
*.old
*.orig
*~
*副本*
*.corrupt-*
*.pre-*

# ---- 历史取证归档(截帧与日志大件, 不入库) ----
docs/archive/

# ---- 本地 CI 与编辑器配置 ----
.github/
.editorconfig

# ---- OS 元数据 ----
Thumbs.db
.DS_Store
